# ──────────────────────────────────────────────────────────────────────
#  airtable-integration — environment variables
# ──────────────────────────────────────────────────────────────────────
#  Copy to `.env` and fill in real values. Never commit `.env`.
#
#  See ASSUMPTIONS.md for why each value is structured the way it is.
# ──────────────────────────────────────────────────────────────────────

# --- Backend HTTP ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
# Default points at the docker-compose service in this repo.
MONGO_URI=mongodb://localhost:27017/airtable_integration

# --- Airtable OAuth (Part A) ---
# Register an OAuth integration at https://airtable.com/create/oauth
# The redirect URI MUST match what you register exactly.
AIRTABLE_OAUTH_CLIENT_ID=
AIRTABLE_OAUTH_CLIENT_SECRET=
AIRTABLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/airtable/callback

# Comma-separated scopes. These cover what the FSD asks for: bases, tables, records, users.
# See https://airtable.com/developers/web/api/scopes
AIRTABLE_OAUTH_SCOPES=data.records:read,data.recordComments:read,schema.bases:read,user.email:read

# --- Airtable scraper login (Part B) ---
# These credentials are used by the headless-browser cookie acquirer.
# ASSUMPTION #4: a single shared "scraper" account is used for the demo.
AIRTABLE_SCRAPER_EMAIL=
AIRTABLE_SCRAPER_PASSWORD=

# --- Encryption keys (32+ bytes, hex or random base64) ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
SCRAPER_ENCRYPTION_KEY=

# --- Frontend dev origin (allowed by CORS) ---
WEB_ORIGIN=http://localhost:4200
